{
    "ConnectionStrings": {
        "DefaultConnection": "Host=localhost;Port=5432;Database=ECommerceDb;Username=YOUR_USERNAME;Password=YOUR_PASSWORD",
        "RedisConnection": "localhost:6379,abortConnect=false"
    },
    "Jwt": {
        "Issuer": "https://api.ecommerce.com",
        "Audience": "https://ecommerce.com",
        "Secret": "YOUR_STRONG_SECRET_KEY_AT_LEAST_32_CHARS_LONG",
        "ExpiryMinutes": 60
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:3000",
            "https://ecommerce.com"
        ]
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
                "Microsoft.AspNetCore.Routing": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ],
        "Enrich": [
            "FromLogContext",
            "WithMachineName",
            "WithThreadId"
        ]
    },
    "Cloudinary": {
        "CloudName": "YOUR_CLOUDINARY_CLOUD_NAME",
        "ApiKey": "YOUR_CLOUDINARY_API_KEY",
        "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
    },
    "Google": {
        "ClientId": "YOUR_GOOGLE_CLIENT_ID",
        "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "Moyasar": {
        "ApiKey": "YOUR_MOYASAR_API_KEY",
        "BaseUrl": "https://api.moyasar.com/v1"
    },
    "EmailSettings": {
        "SmtpServer": "smtp.example.com",
        "SmtpPort": 587,
        "SenderName": "E-Commerce",
        "SenderEmail": "no-reply@ecommerce.com",
        "Username": "YOUR_SMTP_USERNAME",
        "Password": "YOUR_SMTP_PASSWORD"
    },
    "N8n": {
        "WebhookUrl": "YOUR_N8N_WEBHOOK_URL",
        "AuthToken": "YOUR_N8N_AUTH_TOKEN"
    }
}
